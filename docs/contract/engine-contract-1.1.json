{
  "schema": "gamedirector.engine-contract",
  "version": {
    "major": 1,
    "minor": 1
  },
  "capture": {
    "minFrameRate": 1,
    "maxFrameRate": 60,
    "minDimension": 64,
    "maxWidth": 3840,
    "maxHeight": 2160,
    "maxTakeSeconds": 600,
    "idleLeaseSeconds": 60
  },
  "frameClock": {
    "alignmentToleranceFrames": 1E-05,
    "cueEpsilonSeconds": 1E-09
  },
  "camera": {
    "currentAnchor": "current",
    "lens": {
      "defaultFov": 50,
      "sensorSizeMm": 24,
      "minFov": 5,
      "maxFov": 170,
      "resolution": "fov, else focalToFov(focalLengthMm), else defaultFov",
      "focalToFov": {
        "id": "vertical-2atan",
        "expression": "fovDeg = degrees(2*atan(sensorSizeMm/(2*focalLengthMm))) (vertical)"
      },
      "samples": [
        {
          "focalLengthMm": 50,
          "fov": 26.991467,
          "tolerance": 0.001
        },
        {
          "focalLengthMm": 35,
          "fov": 37.84929,
          "tolerance": 0.001
        }
      ],
      "aspect": {
        "id": "hor-plus",
        "expression": "fov is vertical at every aspect; tan(hfov/2)=tan(fov/2)*width/height",
        "samples": [
          {
            "pan": 5,
            "tilt": 0,
            "roll": 0,
            "fov": 50,
            "aspect": 0.5625,
            "x": 0.33322662,
            "y": 0.5,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          },
          {
            "pan": 5,
            "tilt": 0,
            "roll": 0,
            "fov": 50,
            "aspect": 1.7777778,
            "x": 0.44723186,
            "y": 0.5,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          },
          {
            "pan": 10,
            "tilt": 0,
            "roll": 0,
            "fov": 50,
            "aspect": 0.5625,
            "x": 0.16388051,
            "y": 0.5,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          },
          {
            "pan": 10,
            "tilt": 0,
            "roll": 0,
            "fov": 50,
            "aspect": 1.7777778,
            "x": 0.3936497,
            "y": 0.5,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          },
          {
            "pan": 20,
            "tilt": 15,
            "roll": 30,
            "fov": 50,
            "aspect": 0.5625,
            "x": 0.1333328,
            "y": 0.95083505,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          },
          {
            "pan": 20,
            "tilt": 15,
            "roll": 30,
            "fov": 50,
            "aspect": 1.7777778,
            "x": 0.3839842,
            "y": 0.95083505,
            "tolerance": 0.0001,
            "liveTolerance": 0.02
          }
        ]
      }
    },
    "frames": [
      {
        "id": "extreme-closeup",
        "coverage": 2.8
      },
      {
        "id": "closeup",
        "coverage": 1.5
      },
      {
        "id": "medium",
        "coverage": 1.05
      },
      {
        "id": "full",
        "coverage": 0.8
      },
      {
        "id": "wide",
        "coverage": 0.4
      }
    ],
    "fallbackFrame": "wide",
    "progress": {
      "id": "clamp01-linear",
      "expression": "p = durationSeconds \u003E 0 ? clamp01((t - shotStart) / durationSeconds) : 0; e = ease(p); the camera runs on the unscaled timeline clock (world.timescale scales the world only)"
    },
    "eases": [
      {
        "id": "linear",
        "formula": "identity",
        "expression": "p",
        "samples": [
          {
            "p": 0,
            "e": 0
          },
          {
            "p": 0.25,
            "e": 0.25
          },
          {
            "p": 0.5,
            "e": 0.5
          },
          {
            "p": 0.75,
            "e": 0.75
          },
          {
            "p": 1,
            "e": 1
          }
        ]
      },
      {
        "id": "in",
        "formula": "quad-in",
        "expression": "p*p",
        "samples": [
          {
            "p": 0,
            "e": 0
          },
          {
            "p": 0.25,
            "e": 0.0625
          },
          {
            "p": 0.5,
            "e": 0.25
          },
          {
            "p": 0.75,
            "e": 0.5625
          },
          {
            "p": 1,
            "e": 1
          }
        ]
      },
      {
        "id": "out",
        "formula": "quad-out",
        "expression": "1-(1-p)*(1-p)",
        "samples": [
          {
            "p": 0,
            "e": 0
          },
          {
            "p": 0.25,
            "e": 0.4375
          },
          {
            "p": 0.5,
            "e": 0.75
          },
          {
            "p": 0.75,
            "e": 0.9375
          },
          {
            "p": 1,
            "e": 1
          }
        ]
      },
      {
        "id": "inOut",
        "formula": "smoothstep",
        "expression": "p*p*(3-2*p)",
        "samples": [
          {
            "p": 0,
            "e": 0
          },
          {
            "p": 0.25,
            "e": 0.15625
          },
          {
            "p": 0.5,
            "e": 0.5
          },
          {
            "p": 0.75,
            "e": 0.84375
          },
          {
            "p": 1,
            "e": 1
          }
        ]
      }
    ],
    "motions": [
      {
        "id": "hold",
        "expression": "pos = from",
        "meaning": "Hold the resolved start position, even with an authored to.",
        "reads": [],
        "samples": [
          {
            "ease": "inOut",
            "p": 0.5,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "displacement",
            "expected": 0,
            "tolerance": 0
          },
          {
            "ease": "linear",
            "p": 1,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "displacement",
            "expected": 0,
            "tolerance": 0
          }
        ]
      },
      {
        "id": "lerp",
        "expression": "pos = lerp(from, to, e)",
        "meaning": "Interpolate to the resolved authored destination (dolly and crane).",
        "reads": [],
        "samples": [
          {
            "ease": "linear",
            "p": 0.25,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 0.25,
            "tolerance": 0
          },
          {
            "ease": "inOut",
            "p": 0.25,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 0.15625,
            "tolerance": 0
          },
          {
            "ease": "in",
            "p": 0.5,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 0.25,
            "tolerance": 0
          },
          {
            "ease": "out",
            "p": 0.5,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 0.75,
            "tolerance": 0
          },
          {
            "ease": "inOut",
            "p": 1,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 1,
            "tolerance": 0
          },
          {
            "ease": "inOut",
            "p": 0.75,
            "authoredTo": true,
            "stepSubject": false,
            "observable": "fraction",
            "expected": 0.84375,
            "tolerance": 0
          }
        ]
      },
      {
        "id": "orbit-up",
        "expression": "pos = target(t) \u002B rotateUp(from - target0, orbitDeg * e)",
        "meaning": "Orbit about world up; \u002B carries the camera toward its own left (clockwise seen from above).",
        "reads": [
          "orbitDeg"
        ],
        "samples": [
          {
            "ease": "linear",
            "p": 0.5,
            "params": {
              "orbitDeg": 90
            },
            "authoredTo": false,
            "stepSubject": false,
            "observable": "radius",
            "expected": 4,
            "tolerance": 0.0001
          },
          {
            "ease": "linear",
            "p": 0.5,
            "params": {
              "orbitDeg": 90
            },
            "authoredTo": false,
            "stepSubject": false,
            "observable": "swept-deg",
            "expected": 45,
            "tolerance": 0.001
          },
          {
            "ease": "linear",
            "p": 0.5,
            "params": {
              "orbitDeg": 90
            },
            "authoredTo": false,
            "stepSubject": false,
            "observable": "side",
            "expected": -1,
            "tolerance": 0
          },
          {
            "ease": "inOut",
            "p": 1,
            "authoredTo": false,
            "stepSubject": false,
            "observable": "swept-deg",
            "expected": 90,
            "tolerance": 0.001
          },
          {
            "ease": "inOut",
            "p": 1,
            "authoredTo": false,
            "stepSubject": false,
            "observable": "side",
            "expected": -1,
            "tolerance": 0
          },
          {
            "ease": "linear",
            "p": 0.5,
            "params": {
              "orbitDeg": -60
            },
            "authoredTo": false,
            "stepSubject": false,
            "observable": "swept-deg",
            "expected": 30,
            "tolerance": 0.001
          },
          {
            "ease": "linear",
            "p": 0.5,
            "params": {
              "orbitDeg": -60
            },
            "authoredTo": false,
            "stepSubject": false,
            "observable": "side",
            "expected": 1,
            "tolerance": 0
          }
        ]
      },
      {
        "id": "track-offset",
        "expression": "pos = target(t) \u002B (from - target0)",
        "meaning": "Follow the subject while preserving the start offset.",
        "reads": [],
        "samples": [
          {
            "ease": "linear",
            "p": 0.5,
            "authoredTo": false,
            "stepSubject": true,
            "observable": "drift",
            "expected": 0,
            "tolerance": 1E-05
          }
        ]
      }
    ],
    "shots": [
      {
        "id": "lockoff",
        "requiresTarget": false,
        "motion": "hold"
      },
      {
        "id": "dolly",
        "requiresTarget": true,
        "motion": "lerp"
      },
      {
        "id": "crane",
        "requiresTarget": true,
        "motion": "lerp"
      },
      {
        "id": "orbit",
        "requiresTarget": false,
        "motion": "orbit-up"
      },
      {
        "id": "tracking",
        "requiresTarget": false,
        "motion": "track-offset"
      }
    ],
    "params": [
      {
        "name": "targetHeight",
        "unit": "m",
        "meaning": "Authored aim height above the subject pivot: replaces the bounds-center offset with (0,targetHeight,0); omitted = full vector (subject bounds center - subject pivot) at shot start.",
        "derivation": "subject-bounds-center"
      },
      {
        "name": "coverage",
        "unit": "subject-heights",
        "meaning": "Auto-framing fill: subject height as a fraction of frame height (from:current only); defaults to the frame size\u0027s coverage.",
        "derivation": "frame-coverage"
      },
      {
        "name": "distance",
        "default": 0,
        "unit": "m",
        "meaning": "Camera distance from the subject along the current view direction; 0 = derive from frame coverage."
      },
      {
        "name": "offsetX",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved start position."
      },
      {
        "name": "offsetY",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved start position."
      },
      {
        "name": "offsetZ",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved start position."
      },
      {
        "name": "toOffsetX",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved destination of a moving shot."
      },
      {
        "name": "toOffsetY",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved destination of a moving shot."
      },
      {
        "name": "toOffsetZ",
        "default": 0,
        "unit": "m",
        "meaning": "World-axis offset added to the resolved destination of a moving shot."
      },
      {
        "name": "orbitDeg",
        "default": 90,
        "unit": "deg",
        "meaning": "Total orbit sweep across the shot duration; \u002B carries the camera toward its own left (clockwise seen from above)."
      },
      {
        "name": "shake",
        "default": 0,
        "unit": "m",
        "meaning": "Handheld vertical shake; amplitude ~value x 0.025 m; 0 = locked off."
      },
      {
        "name": "tilt",
        "default": 0,
        "unit": "deg",
        "meaning": "Pitch applied after aiming; \u002B looks down."
      },
      {
        "name": "pan",
        "default": 0,
        "unit": "deg",
        "meaning": "Yaw applied after aiming; \u002B turns right."
      },
      {
        "name": "roll",
        "default": 0,
        "unit": "deg",
        "meaning": "Roll around the view axis applied after aiming; applied after pan and tilt; \u002B turns screen content clockwise (pinned by camera.aim.samples)."
      },
      {
        "name": "endFov",
        "unit": "deg",
        "meaning": "Fov at shot end; ramps from the start fov across the shot.",
        "derivation": "start-fov"
      }
    ],
    "derivations": {
      "subject-bounds-center": "when targetHeight is omitted, aim offset = full vector (subject bounds center - subject pivot) at shot start, preserving X, Y and Z; when authored, aim offset = (0,targetHeight,0)",
      "frame-coverage": "coverage = Coverage(frame) at shot start",
      "start-fov": "endFov = start fov"
    },
    "aim": {
      "order": "LookRotation(aim) * Euler(tilt, pan, roll): intrinsic yaw(pan), pitch(tilt), roll(roll); signs viewer-relative",
      "samples": [
        {
