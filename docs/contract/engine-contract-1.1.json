        "code": "busy"
      },
      "timeout": {
        "status": 504,
        "code": "timeout"
      },
      "internal": {
        "status": 500,
        "code": "internal"
      },
      "forbidden": {
        "status": 403,
        "code": "forbidden"
      },
      "notFound": {
        "status": 404,
        "code": "not_found"
      },
      "methodNotAllowed": {
        "status": 405,
        "code": "method_not_allowed"
      },
      "unsupportedMediaType": {
        "status": 415,
        "code": "unsupported_media_type"
      },
      "payloadTooLarge": {
        "status": 413,
        "code": "payload_too_large"
      }
    }
  },
  "take": {
    "states": {
      "capturing": "Capturing",
      "completed": "Completed",
      "failed": "Failed",
      "cancelled": "Cancelled"
    },
    "silentPictureAudio": "silent-picture; mix audio in the edit",
    "requestDefaults": {
      "captureFromFrame": 0,
      "advanceOnly": false
    }
  },
  "capabilities": [
    {
      "key": "actor.spawn",
      "kind": "enum",
      "values": [
        {
          "value": "supported",
          "meaning": "actor.spawn cues execute"
        },
        {
          "value": "unsupported",
          "meaning": "every actor.spawn cue is refused at compile time, GD1012"
        }
      ],
      "undeclared": "unrestricted",
      "declarer": "adapter",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "Whether actor.spawn cues can execute on this stage.",
      "rules": [
        {
          "when": "unsupported",
          "effect": "forbid-cue",
          "cueType": "actor.spawn",
          "field": "type",
          "remedy": "bind the role in the scene (presentAtStart) instead"
        }
      ]
    },
    {
      "key": "actor.animation.fade",
      "kind": "enum",
      "values": [
        {
          "value": "crossfade",
          "meaning": "fade \u003E 0 crossfades over fade seconds"
        },
        {
          "value": "cut-only",
          "meaning": "actor.anim with fade \u003E 0 is refused, GD1012"
        }
      ],
      "undeclared": "unrestricted",
      "declarer": "adapter",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "How actor.anim fades are performed.",
      "rules": [
        {
          "when": "cut-only",
          "effect": "require-zero",
          "cueType": "actor.anim",
          "field": "fade",
          "remedy": "set fade: 0"
        }
      ]
    },
    {
      "key": "camera.params",
      "kind": "name-list",
      "separator": ",",
      "itemSyntax": "a letter, then letters, digits or \u0027_\u0027",
      "undeclared": "builtin-table",
      "declarer": "adapter-or-engine",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "Complete set of shot param names the engine implements; built-in names keep their contract meaning, other names belong to custom shot types.",
      "rules": [
        {
          "effect": "restrict-shot-params",
          "cueType": "camera.shot",
          "field": "shot.params"
        }
      ]
    },
    {
      "key": "director.mode",
      "kind": "enum",
      "values": [
        {
          "value": "offline-sandbox",
          "meaning": "fully reversible, clocked presentation owned by the director"
        }
      ],
      "undeclared": "absent",
      "declarer": "adapter-or-engine",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "How the director may drive the game.",
      "rules": []
    },
    {
      "key": "project.sourceRoot",
      "kind": "absolute-path",
      "undeclared": "absent",
      "declarer": "engine",
      "identity": "volatile",
      "exposure": "machine-local",
      "description": "Absolute path of the connected game source; capture output must be written outside it.",
      "rules": []
    },
    {
      "key": "presentation.sourceFingerprint",
      "kind": "token",
      "undeclared": "absent",
      "declarer": "engine",
      "identity": "volatile",
      "exposure": "machine-local",
      "description": "Live visual/source identity; a take is valid only against it.",
      "rules": []
    },
    {
      "key": "engine",
      "kind": "identifier",
      "itemSyntax": "a letter, then letters, digits or \u0027_\u0027",
      "undeclared": "absent",
      "declarer": "engine",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "Engine family id stamped by the bridge (Three: three); informational.",
      "rules": []
    },
    {
      "key": "capture.audio",
      "kind": "enum",
      "values": [
        {
          "value": "post-production",
          "meaning": "picture capture is silent; mix audio in the edit; see take.silentPictureAudio"
        }
      ],
      "undeclared": "absent",
      "declarer": "adapter-or-engine",
      "identity": "vocabulary",
      "exposure": "public",
      "description": "Informational: TakeAdmission refuses audio cues regardless.",
      "rules": []
    }
