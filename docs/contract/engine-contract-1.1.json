      "health": "health",
      "manifest": "manifest",
      "timelinePlay": "timeline/play",
      "timelineStop": "timeline/stop",
      "takeStart": "take/start",
      "takeFrame": "take/frame",
      "takeStop": "take/stop",
      "take": "take",
      "status": "status",
      "capture": "capture",
      "contract": "contract",
      "stage": "stage"
    },
    "limits": {
      "maxRequestBytes": 1048576,
      "maxQueuedRequests": 32,
      "mainThreadJobsPerUpdate": 4
    },
    "budgets": {
      "engineWaitSeconds": 15,
      "deliverySlackSeconds": 15,
      "requestTimeoutSeconds": 30,
      "compileSeconds": 30,
      "pageLoadSeconds": 30,
      "stageReadySeconds": 30,
      "startSlackSeconds": 10,
      "takeStartTimeoutSeconds": 100
    },
    "errors": {
      "invalidRequest": {
        "status": 400,
        "code": "invalid_request"
      },
      "stateConflict": {
        "status": 409,
        "code": "state_conflict"
      },
