    "rig": {
      "nearClip": 0.03,
      "farClip": 1000,
      "minSubjectHeight": 0.1,
      "degenerateSqrMagnitude": 0.01,
      "aimEpsilonSqrMagnitude": 1E-05,
      "autoFrameFallback": {
        "up": 0.25,
        "back": 1
      },
      "distanceFallback": {
        "up": 0.2,
        "back": 1
      },
      "backAxis": "back is opposite the engine\u0027s forward: Unity -Z, Three \u002BZ",
      "autoFrameDistance": {
        "id": "height-over-coverage",
        "expression": "from:current and distance \u003C= 0 only: max(minSubjectHeight, subjectHeight) / (2*tan(fov/2)*coverage) along (start - target), or autoFrameFallback when lengthSq \u003C degenerateSqrMagnitude"
      },
      "samples": [
        {
          "frame": "full",
          "radius3D": 2.680634,
          "tolerance": 0.001
        },
        {
          "frame": "full",
          "coverage": 1.5,
          "radius3D": 1.429671,
          "tolerance": 0.001
        }
      ]
    },
    "shake": {
      "noise": "unity-perlin-2d",
      "clock": "shot-elapsed-seconds",
      "frequencyHz": 7.3,
      "row": 0.5,
      "center": 0.5,
      "scale": 0.05,
      "expression": "position \u002B= up * (((noise(elapsed*frequencyHz, row) - center) * scale) * shake)"
    },
    "scene": {
      "subjectSize": [
        1,
        2,
        1
      ],
      "subjectCenter": [
        0,
        1,
        0
      ],
      "from": [
        0,
        1,
        -4
      ],
      "to": [
        4,
        1,
        -4
      ],
      "subjectStep": [
        1,
        0,
        0
      ],
      "durationSeconds": 1,
      "aspect": 1,
      "targetHeightNote": "The centered base fixture makes omitted targetHeight equivalent to targetHeight=1 only because the bounds-center offset has zero X/Z. Also characterize an off-center subject: with pivot (0,0,0) and bounds center (1,1,0.5), omission keeps offset (1,1,0.5), while targetHeight=1 uses (0,1,0); these poses must differ.",
      "observables": {
        "fraction": "|pos-from|/|to-from|",
        "displacement": "|pos-from|",
        "radius": "horizontal |pos-target|",
        "radius3d": "|pos-target|",
        "swept-deg": "unsigned horizontal angle between (from-target0) and (pos-target)",
        "side": "sign(dot(pos-pos0, cameraRight at p=0))",
        "drift": "|(pos-target(t))-(from-target0)|"
      }
    }
  },
  "review": {
    "intervalSeconds": 1,
    "rule": "a rendered (not advance-only) timeline frame i is reviewed iff i % (fps*intervalSeconds) == 0, counted from timeline frame 0",
