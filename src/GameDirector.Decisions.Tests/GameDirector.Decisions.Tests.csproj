<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\TempPaths.cs" Link="TempPaths.cs" />
    <Compile Include="..\TestSupport\TestBudget.cs" Link="TestBudget.cs" />
    <ProjectReference Include="..\GameDirector.Core\GameDirector.Core.csproj" />
    <ProjectReference Include="..\GameDirector.Client\GameDirector.Client.csproj" />
    <ProjectReference Include="..\GameDirector.Decisions\GameDirector.Decisions.csproj" />
    <ProjectReference Include="..\GameDirector.Workbench\GameDirector.Workbench.csproj" />
  </ItemGroup>

  <!-- Frozen v1 document store produced by the unmodified baseline code; never edit. -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
