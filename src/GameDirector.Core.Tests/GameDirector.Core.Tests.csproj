<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\TempPaths.cs" Link="TempPaths.cs" />
    <Compile Include="..\TestSupport\LoopbackHttp.cs" Link="LoopbackHttp.cs" />
    <Compile Include="..\TestSupport\TestBudget.cs" Link="TestBudget.cs" />
    <ProjectReference Include="..\GameDirector.Core\GameDirector.Core.csproj" />
    <ProjectReference Include="..\GameDirector.Client\GameDirector.Client.csproj" />
    <ProjectReference Include="..\TestSupport\RuntimeLauncherProbe\RuntimeLauncherProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Repo-level sample assets are part of the contract: they must always compile. -->
  <ItemGroup>
    <Content Include="..\..\samples\timelines\stardeck\v1.json" Link="Samples\stardeck.v1.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\adapters\stardeck\manifest.json" Link="Samples\stardeck.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\adapters\sandring\manifest.json" Link="Samples\sandring.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\timelines\sandring\timeline.json" Link="Samples\sandring.timeline.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\timelines\sandring\scout.json" Link="Samples\sandring.scout.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
