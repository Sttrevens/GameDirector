<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameDirector.Mcp</RootNamespace>
    <AssemblyName>gamedirector-mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gamedirector-mcp</ToolCommandName>
    <PackageId>GameDirector.Mcp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameDirector.Mcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameDirector.Client\GameDirector.Client.csproj" />
    <ProjectReference Include="..\GameDirector.Decisions\GameDirector.Decisions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

</Project>
